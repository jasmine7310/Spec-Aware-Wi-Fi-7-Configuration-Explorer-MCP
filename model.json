  "constraints": [
    {
      "applies_to": [
        "ap_akm",
        "link_akm_mismatch",
        "ap_pairwise_cipher"
      ],
      "coded": true,
      "id": "SEC.MLD_COMMON_SUITES",
      "kind": "normative",
      "predicate": "Every AP link has the same pairwise cipher, and the intersection of the links' AKM lists is non-empty.",
      "role": "forbidden",
      "status": "reviewed"
    },
    {
      "applies_to": [
        "sta_akm",
        "ap_akm"
      ],
      "coded": true,
      "id": "SEC.MLD_CLIENT_COMMON_AKM",
      "kind": "normative",
      "predicate": "If the links share at least one AKM, at least one of the client's allowed AKMs is among them.",
      "role": "forbidden",
      "status": "reviewed"
    },
    {
      "applies_to": [
        "ap_beacon_protection",
        "sta_beacon_protection"
      ],
      "coded": true,
      "id": "SEC.EHT_BEACON_PROT",
      "kind": "normative",
      "predicate": "ap.beacon_protection and sta.beacon_protection are both true whenever RSN is used.",
      "role": "forbidden",
      "status": "reviewed"
    },
    {
      "applies_to": [
        "ap_pmf",
        "sta_pmf"
      ],
      "coded": false,
      "id": "SEC.PMF",
      "kind": "normative",
      "predicate": "ap.pmf is not disabled (hostapd ieee80211w != 0).",
      "role": "forbidden",
      "status": "reviewed"
    },
    {
      "applies_to": [
        "ap_akm",
        "sta_akm"
      ],
      "coded": true,
      "id": "SEC.EHT_SAE_AKM",
      "kind": "normative",
      "predicate": "If the negotiated AKM is SAE-family, it is SAE-EXT-KEY, not SAE.",
      "role": "forbidden",
      "status": "reviewed"
    },
    {
      "applies_to": [
        "ap_sae_pwe",
        "sta_sae_pwe",
        "ap_akm"
      ],
      "coded": true,
      "id": "SEC.EHT_SAE_H2E",
      "kind": "normative",
      "predicate": "With an SAE-family AKM, H2E is in effect: sae_pwe is 1 or 2, or sae_pwe is unset and the AKM is SAE-EXT-KEY. sae_pwe=0, or unset with plain SAE on 2.4 / 5 GHz, fails.",
      "role": "forbidden",
      "status": "reviewed"
    },
    {
      "applies_to": [
        "ap_sae_pwe",
        "sta_sae_pwe",
        "ap_akm"
      ],
      "coded": true,
      "id": "SEC.SAE_PWE_NEEDS_SAE",
      "kind": "dependency",
      "predicate": "If the AP's sae_pwe is set, an AP link's AKM list includes SAE or SAE-EXT-KEY; if the client's sae_pwe is set, the client allows SAE or SAE-EXT-KEY.",
      "role": "dependency",
      "status": "reviewed"
    },
    {
      "applies_to": [
        "ap_sae_pwe",
        "sta_sae_pwe",
        "ap_akm",
        "sta_akm"
      ],
      "coded": true,
      "id": "SEC.SAE_H2E_ONLY_NEEDS_STA_H2E",
      "kind": "dependency",
      "predicate": "If the AP's sae_pwe is 1 (hash_to_element) and some AP link offers only SAE-family AKMs, and the client allows an SAE-family AKM, then the client's sae_pwe is 1 or 2.",
      "role": "dependency",
      "status": "draft"
    },
    {
      "applies_to": [
        "rekey_gtk_now",
        "link_remove",
        "ap_disassociate",
        "ap_deauthenticate",
        "bss_tm_link_removal_imminent",
        "setup_link_reconfig",
        "sta_disconnect_reconnect",
        "associate"
      ],
      "coded": true,
      "id": "AO.ASSOC_REQUIRED",
      "kind": "harness",
      "predicate": "state.associated is true before the action, and false before associate.",
      "role": "action_order",
      "status": "reviewed"
    },
    {
      "applies_to": [
        "ml_probe_req"
      ],
      "coded": true,
      "id": "AO.ML_PROBE_STATE",
      "kind": "harness",
      "predicate": "The AP was seen in a prior scan, and the STA is disconnected (not associated).",
      "role": "action_order",
      "status": "reviewed"
    },
    {
      "applies_to": [
        "link_remove"
      ],
      "coded": true,
      "id": "AO.LINK_MUST_EXIST",
      "kind": "harness",
      "predicate": "link in state.ap_links; afterwards remove it from ap_links and from the STA's active links.",
      "role": "action_order",
      "status": "reviewed"
    },
    {
      "applies_to": [
        "link_remove",
        "associate",
        "setup_link_reconfig"
      ],
      "coded": true,
      "id": "AO.NO_LINKS_LEFT",
      "kind": "harness",
      "predicate": "If state.active_links becomes empty, set state.associated to false. associate needs at least one AP link that isn't disabled.",
      "role": "action_order",
      "status": "reviewed"
    },
    {
      "applies_to": [
        "setup_link_reconfig"
      ],
      "coded": true,
      "id": "AO.RECONFIG_DELETE_ACTIVE",
      "kind": "harness",
      "predicate": "link in state.active_links; afterwards remove it.",
      "role": "action_order",
      "status": "reviewed"
    },
    {
      "applies_to": [
        "setup_link_reconfig"
